    "Grant access under Privacy & Security → Files and Folders, then Ledge resumes automatically.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik ve Güvenlik → Dosyalar ve Klasörler altından erişim verin, Ledge kendiliğinden devam eder."
          }
        }
      }
    },
    "It is no longer where Ledge found it.": {
      "comment": "Why a move failed: the file was gone before Ledge could move it.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya, Ledge'in bulduğu yerde artık yok."
          }
        }
      }
    },
