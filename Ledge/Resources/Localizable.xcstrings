      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledge, %@ klasörünü göremiyor"
          }
        }
      }
    },
    "Ledge can't write to %@.": {
      "comment": "Why a move failed, where %@ is the destination folder's name.",
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ledge %@ klasörüne yazamıyor."
