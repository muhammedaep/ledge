{
  "sourceLanguage": "en",
  "strings": {
    "%@ is higher up and already takes %@, so they never reach here.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is higher up and already takes %@, so they never reach here."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ daha yukarıda ve şunları zaten alıyor: %2$@ — bu yüzden buraya hiç ulaşmıyorlar."
          }
        }
      }
    },
    "%@ · whole folder": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · klasörün tamamı"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld items would move. Folders move whole — Ledge never files their contents.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld öğe taşınacak. Klasörler bütün halinde taşınır — Ledge içlerini klasörlemez."
          }
        }
      }
    },
    "A folder name can't contain “/” or “:”, or be only dots.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A folder name can't contain “/” or “:”, or be only dots."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör adı “/” ya da “:” içeremez, yalnızca noktalardan da oluşamaz."
          }
        }
      }
    },
    "A name starting with a dot is hidden in the Finder.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name starting with a dot is hidden in the Finder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noktayla başlayan bir ad Finder'da gizlenir."
          }
        }
      }
    },
    "Add Folder…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Folder…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör Ekle…"
          }
        }
      }
    },
    "Add Project…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add Project…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje Ekle…"
          }
        }
      }
    },
    "Add a folder to watch in Settings first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder to watch in Settings first."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Ayarlar'dan izlenecek bir klasör ekleyin."
          }
        }
      }
    },
    "All new downloads go here until you end the project.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeyi bitirene kadar yeni indirilenler buraya gider."
          }
        }
      }
    },
    "Another rule is also called “%@”. They share one folder, each still applying its own subfolder setting inside it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another rule is also called “%@”. They share one folder, each still applying its own subfolder setting inside it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kural da “%@” adını taşıyor. Aynı klasörü paylaşırlar; her biri kendi alt klasör ayarını orada uygulamayı sürdürür."
          }
        }
      }
    },
    "Another rule's name differs from “%@” only in capitalisation or accent spelling. On a case-insensitive disk — the macOS default — that is one folder, holding both rules' subfolders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another rule's name differs from “%@” only in capitalisation or accent spelling. On a case-insensitive disk — the macOS default — that is one folder, holding both rules' subfolders."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir kuralın adı “%@” adından yalnızca büyük/küçük harf ya da aksan yazımıyla ayrılıyor. Büyük/küçük harf ayrımı yapmayan bir diskte — macOS'un varsayılanı — bu tek bir klasördür ve iki kuralın da alt klasörlerini barındırır."
          }
        }
      }
    },
    "By extension": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
